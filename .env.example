# PostgreSQL (Supabase / Railway / Neon / local)
# App: transaction pooler (6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migraciones / db push: session pooler (5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Vercel Blob (logos y fotos). Vercel → Storage → Create → Blob → conectar al proyecto (se inyecta solo).
# En local: copiar el token desde Storage → tu Blob → .env.local
BLOB_READ_WRITE_TOKEN=""

# false = deshabilita /registro (nuevas barberías)
ALLOW_REGISTRATION="true"

# URL pública del sitio (opcional). Mercado Pago la usa para volver al sitio y avisar pagos.
# Si la dejás vacía se detecta sola desde la petición. Ej: https://tu-proyecto.vercel.app
SITE_URL=""

# Clave para cifrar los Access Tokens de Mercado Pago (opcional; si falta se deriva de AUTH_SECRET).
# Generar: openssl rand -base64 32   — OJO: si la cambiás, hay que volver a cargar los tokens.
PAYMENTS_ENC_KEY=""

# --- Suscripciones de las barberías a la plataforma (Mercado Pago) ---
# Access Token de TU cuenta de Mercado Pago (la de la plataforma, no la de cada barbería). Sin esto, no se pueden contratar planes.
MP_PLATFORM_ACCESS_TOKEN=""
# Clave secreta de Webhooks (Mercado Pago → Tus integraciones → Webhooks). Si la cargás, se exige la firma de cada aviso.
MP_WEBHOOK_SECRET=""
# Nombre que figura en el resumen de la tarjeta del cliente ("Turnos · Plan Pro").
APP_NAME="Turnos"
# Solo para pruebas: URL alternativa de la API de Mercado Pago. Dejar vacío en producción.
MP_API_BASE=""

# Firma de sesiones admin: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# Protege /api/cron/dispatch
CRON_SECRET="otro-secreto-largo"

# Credenciales del admin inicial (las usa prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@barberia.com"
SEED_ADMIN_PASSWORD="cambiame123"

# --- WhatsApp Cloud API (dejar vacío = modo consola, solo loguea) ---
WA_ACCESS_TOKEN=""
WA_PHONE_NUMBER_ID=""
WA_API_VERSION="v21.0"
# true = enviar plantillas aprobadas (OBLIGATorio para iniciar conversaciones fuera de la ventana de 24h)
WA_USE_TEMPLATES="false"
WA_TEMPLATE_LANG="es"
WA_TPL_CONFIRM="turno_confirmado"
WA_TPL_REMINDER="turno_recordatorio"
WA_TPL_CANCEL="turno_cancelado"
# Pago recibido: 6 variables {{1}}..{{6}} = nombre, servicio, fecha, hora, negocio, monto
WA_TPL_PAYMENT="turno_pago_recibido"
# Reprogramación: 7 variables = nombre, servicio, fecha, hora, negocio, fecha anterior, hora anterior
WA_TPL_RESCHEDULE="turno_reprogramado"
# Cancelación hecha por el cliente: 5 variables = nombre, servicio, fecha, hora, negocio
WA_TPL_SELFCANCEL="turno_cancelado_cliente"
# true = agrega el código de reclamo como ÚLTIMA variable de las plantillas de confirmación, pago y reprogramación.
# Activarlo SOLO después de editar y volver a aprobar esas plantillas en Meta con la variable extra.
WA_TEMPLATE_CODE_PARAM="false"
