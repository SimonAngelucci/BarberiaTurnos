generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AppointmentStatus {
  /// Reservó y eligió pagar online: el horario queda retenido unos minutos hasta que se aprueba el pago.
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MessageKind {
  CONFIRMATION
  REMINDER
  CANCELLATION
  /// Pago recibido + turno confirmado (reemplaza a CONFIRMATION cuando se pagó online).
  PAYMENT
  /// El cliente reprogramó su turno con el código de reclamo.
  RESCHEDULE
  /// Encuesta posterior al turno: «¿cuánto tiempo te llevó?» (aprendizaje de tiempos por cliente).
  SURVEY
  /// El cliente canceló su turno con el código de reclamo.
  SELF_CANCEL
}

enum AppointmentEventKind {
  CREATED
  RESCHEDULED
  CANCELLED
}

enum EventActor {
  CLIENT
  ADMIN
  SYSTEM
}

enum PaymentMode {
  DEPOSIT_ONLY
  FULL_ONLY
  BOTH
}

enum DepositType {
  PERCENT
  FIXED
}

/// Estado de cobro del turno.
enum PaymentStatus {
  UNPAID
  /// El cliente eligió pagar en el local (efectivo o físico) pudiendo pagar online.
  PENDING_AT_STORE
  DEPOSIT_PAID
  PAID
}

enum PaymentKind {
  DEPOSIT
  FULL
}

enum PaymentState {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

/// Tenant. En el MVP hay una sola fila; todo cuelga de businessId para poder escalar a multi-tenant.
model Business {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  tagline            String   @default("Reservá tu turno online")
  logoUrl            String?
  primaryColor       String   @default("#111827")
  /// Color de fondo de la página pública (y del panel si applyBgToAdmin).
  bgColor            String   @default("#fafafa")
  applyBgToAdmin     Boolean  @default(false)
  /// Guía de bienvenida: 0 = bienvenida, 1 = servicios, 2 = barberos, 3 = mi página, 4 o más = terminada u omitida.
  /// El valor por defecto (4) es para las barberías que ya existían: solo las nuevas la ven (createBusiness la deja en 0).
  onboardingStep     Int      @default(4)
  /// Rubro: define los íconos sugeridos para los servicios (BARBER, TATTOO o NAILS). Ver src/lib/service-icons.ts.
  businessType       String   @default("BARBER")
  /// Aprendizaje de tiempos por cliente (encuesta posterior al turno + duración personalizada). Opcional: apagado por defecto.
  learnDurations     Boolean  @default(false)
  /// Diseño de la página pública (editor visual). null = diseño por defecto. Ver src/lib/page-config.ts.
  pageConfig         Json?
  timezone           String   @default("America/Argentina/Buenos_Aires")
  currency           String   @default("ARS")
  /// Cómo se arman los horarios: AUTO = según la duración de cada servicio; MANUAL = inicios cada `slotIntervalMin` minutos.
  /// El valor por defecto es MANUAL, que es como funcionaba antes (las barberías existentes no cambian).
  scheduleMode       ScheduleMode @default(MANUAL)
  /// Intervalo del modo manual. Se conserva aunque se pase a AUTO. También define la grilla para bloquear horarios a mano.
  slotIntervalMin    Int      @default(30)
  minNoticeMin       Int      @default(60)
  maxAdvanceDays     Int      @default(30)
  /// Minutos antes del turno en que se envía recordatorio. Ej: [1440, 120]
  reminderOffsetsMin Int[]    @default([1440, 120])
  confirmTemplate    String   @default("Hola {{nombre}}! Tu turno de {{servicio}} en {{negocio}} quedó confirmado para el {{fecha}} a las {{hora}}. ¡Te esperamos!")
  reminderTemplate   String   @default("Hola {{nombre}}, te recordamos tu turno de {{servicio}} en {{negocio}}: {{fecha}} a las {{hora}}.")
  cancelTemplate     String   @default("Hola {{nombre}}, lamentablemente tu turno de {{servicio}} del {{fecha}} a las {{hora}} en {{negocio}} fue cancelado. Escribinos para reprogramar.")
  paymentTemplate    String   @default("Hola {{nombre}}! Recibimos tu pago de {{monto}} por tu turno de {{servicio}} en {{negocio}}. Quedó confirmado para el {{fecha}} a las {{hora}}. ¡Te esperamos!")

  // --- Reprogramar / cancelar por el cliente (con el código de reclamo) ---
  allowClientChanges Boolean  @default(true)
  /// Anticipación mínima, en minutos, para poder reprogramar o cancelar (0 = hasta el momento del turno).
  changeMinNoticeMin Int      @default(120)
  rescheduleTemplate String   @default("Hola {{nombre}}, tu turno de {{servicio}} en {{negocio}} fue reprogramado: ahora es el {{fecha}} a las {{hora}} (antes: {{fecha_anterior}} a las {{hora_anterior}}). Tu código sigue siendo {{codigo}}.")
  selfCancelTemplate String   @default("Hola {{nombre}}, cancelaste tu turno de {{servicio}} del {{fecha}} a las {{hora}} en {{negocio}}. Cuando quieras, reservá uno nuevo.")

  // --- Pagos (Mercado Pago, credenciales propias de cada barbería) ---
  paymentsEnabled    Boolean     @default(false)
  paymentMode        PaymentMode @default(BOTH)
  depositType        DepositType @default(PERCENT)
  /// PERCENT: 1–100. FIXED: monto en centavos.
  depositValue       Int         @default(30)
  /// Permite reservar sin pagar en el momento ("Pagar después").
  allowPayLater      Boolean     @default(true)
  /// Access Token de Mercado Pago, cifrado (AES-256-GCM). Nunca se devuelve al navegador.
  mpAccessToken      String?
  /// Etiqueta de la cuenta conectada (ej. nickname) para mostrar en el panel.
  mpAccountLabel     String?

  // --- Suscripción a la plataforma ---
  /// Cuenta exenta de cobro (demo, socios, pruebas): siempre con acceso completo.
  billingExempt      Boolean  @default(false)
  /// Creador (influencer) cuyo código se usó al registrarse.
  creatorId          String?
  /// Código tal como se ingresó al registrarse; queda guardado aunque el código se desactive después.
  creatorCode        String?
  createdAt          DateTime @default(now())

  creator      Creator?       @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  subscription Subscription?
  admins       AdminUser[]
  barbers      Barber[]
  services     Service[]
  customers    Customer[]
  appointments Appointment[]
  timeOffs     TimeOff[]
  messages     Message[]
  profile      BusinessProfile?
  photos       BusinessPhoto[]
  reviews      Review[]
}

model AdminUser {
  id           String   @id @default(cuid())
  businessId   String
  email        String   @unique
  passwordHash String
  /// Nombre del responsable / dueño de la cuenta.
  name         String?
  /// Preferencia de avisos importantes por email (suscripción, cobros, seguridad).
  emailNotifications Boolean @default(true)
  /// Los tokens de sesión emitidos antes de esta fecha ya no valen (cerrar todas las sesiones / cambio de contraseña).
  tokensValidAfter DateTime?
  /// Hasta cuándo se marcaron como leídas las notificaciones del panel.
  notificationsSeenAt DateTime?
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions     AdminSession[]
}

/// Una sesión iniciada en un dispositivo. El token de la cookie lleva este id; revocarla (revokedAt) la invalida de inmediato.
model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ip         String?
  revokedAt  DateTime?
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt])
}

model Barber {
  id         String   @id @default(cuid())
  businessId String
  name       String
  photoUrl   String?
  bio        String?
  active     Boolean  @default(true)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  workingHours  WorkingHour[]
  disabledSlots DisabledSlot[]
  appointments  Appointment[]
  timeOffs      TimeOff[]
}

/// Slot individual desactivado dentro de la franja laboral (recurrente por día de semana).
/// startMin = minutos desde 00:00 locales del inicio de la celda (alineada al slotIntervalMin).
model DisabledSlot {
  id       String @id @default(cuid())
  barberId String
  weekday  Int
  startMin Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday, startMin])
}

/// Franja laboral. weekday: 0=domingo ... 6=sábado. Minutos desde 00:00 locales.
/// Varias filas por día = horario cortado (mañana/tarde).
model WorkingHour {
  id       String @id @default(cuid())
  barberId String
  weekday  Int
  startMin Int
  endMin   Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
}

/// Bloqueos (vacaciones, feriados, descansos). barberId null = todo el negocio.
model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  barberId   String?
  startAt    DateTime
  endAt      DateTime
  reason     String?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barber     Barber?  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([businessId, startAt])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  priceCents  Int
  durationMin Int
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// Ícono elegido de la lista del rubro (clave de src/lib/service-icons.ts); null = el predeterminado del rubro.
  iconKey     String?
  /// Ícono propio subido por el negocio (tiene prioridad sobre iconKey).
  iconUrl     String?
  /// «Próximamente»: se ve en la página pública pero todavía no se puede reservar.
  comingSoon  Boolean  @default(false)
  /// Eliminado por el administrador: ya no aparece en ninguna lista (se conserva solo si tiene turnos en el historial).
  archived    Boolean  @default(false)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  appointments Appointment[]
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  firstName  String
  lastName   String
  /// E.164, ej: +5491112345678
  phone      String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  times        CustomerServiceTime[]

  @@unique([businessId, phone])
}

/// Ajustes del tiempo aprendido de un cliente para un servicio. Los datos salen de Appointment.actualDurationMin;
/// acá solo se guarda lo que decide el administrador: un tiempo fijo (overrideMin) o «empezar de cero» (resetAt).
model CustomerServiceTime {
  id          String    @id @default(cuid())
  businessId  String
  customerId  String
  serviceId   String
  /// Tiempo fijado a mano; tiene prioridad sobre lo aprendido.
  overrideMin Int?
  /// Las respuestas de turnos anteriores a esta fecha no cuentan (reseteo sin borrar el historial).
  resetAt     DateTime?
  updatedAt   DateTime  @updatedAt
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, serviceId])
  @@index([businessId])
}

/// startAt/endAt en UTC. La restricción anti-overbooking vive en prisma/constraints.sql.
model Appointment {
  id         String            @id @default(cuid())
  businessId String
  /// null = el barbero fue eliminado; el turno queda en el historial.
  barberId   String?
  serviceId  String
  customerId String
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(CONFIRMED)
  priceCents Int
  paymentStatus   PaymentStatus @default(UNPAID)
  amountPaidCents Int           @default(0)
  /// Código para que el cliente reprograme o cancele (ej. REC-8F3K9A). null en turnos anteriores a esta función.
  claimCode  String?           @unique
  /// Enlace secreto de la encuesta de duración (solo si el negocio aprende tiempos).
  surveyToken String?
  /// Minutos que el cliente dijo que le llevó (o que cargó el administrador). null = sin dato.
  actualDurationMin Int?
  createdAt  DateTime          @default(now())

  events  AppointmentEvent[]
  payments Payment[]
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barber   Barber?  @relation(fields: [barberId], references: [id], onDelete: SetNull)
  service  Service  @relation(fields: [serviceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  messages Message[]

  @@index([businessId, startAt])
  @@index([barberId, startAt])
  @@index([surveyToken])
}

/// Historial de cambios de un turno (creación, reprogramaciones, cancelaciones) y quién los hizo.
model AppointmentEvent {
  id            String               @id @default(cuid())
  businessId    String
  appointmentId String
  kind          AppointmentEventKind
  actor         EventActor
  fromStartAt   DateTime?
  toStartAt     DateTime?
  note          String?
  createdAt     DateTime             @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@index([businessId, createdAt])
}

/// Intento de cobro (una preferencia de Mercado Pago). `id` viaja como external_reference.
model Payment {
  id             String       @id @default(cuid())
  businessId     String
  appointmentId  String
  kind           PaymentKind
  amountCents    Int
  state          PaymentState @default(PENDING)
  mpPreferenceId String?
  mpPaymentId    String?      @unique
  /// Observaciones operativas (ej. cobro aprobado cuando el horario ya se había liberado).
  note           String?
  createdAt      DateTime     @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([businessId, state])
  @@index([appointmentId])
}

/// Outbox de WhatsApp: se inserta en la misma operación que el turno y un worker/cron la despacha.
model Message {
  id            String        @id @default(cuid())
  businessId    String
  appointmentId String?
  kind          MessageKind
  to            String
  body          String
  templateName  String?
  params        Json?
  sendAt        DateTime
  status        MessageStatus @default(PENDING)
  attempts      Int           @default(0)
  error         String?
  externalId    String?
  createdAt     DateTime      @default(now())

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
}

// ============================================================================
// Suscripciones de las barberías a la plataforma (Mercado Pago Suscripciones)
// ============================================================================

enum SubscriptionStatus {
  /// Mes de prueba gratis (sin cobros).
  TRIAL
  ACTIVE
  /// El cobro falló: la cuenta queda en solo lectura hasta regularizar.
  PAST_DUE
  CANCELED
  /// La prueba terminó sin haber contratado un plan.
  EXPIRED
}

enum SubscriptionPaymentStatus {
  APPROVED
  REJECTED
  PENDING
}

enum CreatorBenefit {
  /// Solo registrar cuántas barberías trajo.
  TRACKING
  /// Porcentaje de cada cobro de las barberías que trajo.
  COMMISSION
  /// Meses gratis por cada barbería que paga.
  FREE_MONTHS
}

enum EarningKind {
  COMMISSION
  FREE_MONTHS
}

enum EarningStatus {
  PENDING
  PAID
  VOID
}

/// Planes que contratan las barberías. Los administra el Super Admin.
model Plan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  /// Precio mensual en centavos.
  priceCents  Int
  currency    String   @default("ARS")
  /// Tope de barberos del plan. null = ilimitados.
  maxBarbers  Int?
  /// Lista de características para mostrar (una por línea en el panel).
  features    String[] @default([])
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  subscriptions Subscription[]
}

/// Una por barbería. `status` se mantiene con webhooks y un proceso periódico; el acceso real se calcula en src/lib/billing.ts.
model Subscription {
  id               String             @id @default(cuid())
  businessId       String             @unique
  /// Plan elegido (puede estar pendiente de autorizar en Mercado Pago).
  planId           String?
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime
  /// Fin del período ya cobrado (o fecha del próximo cobro).
  currentPeriodEnd DateTime?
  nextPaymentAt    DateTime?
  /// Suscripción (preapproval) en Mercado Pago y su estado: pending | authorized | paused | cancelled.
  mpPreapprovalId  String?            @unique
  mpStatus         String?
  /// Link de Mercado Pago para terminar de autorizar la suscripción.
  mpInitPoint      String?
  payerEmail       String?
  pastDueSince     DateTime?
  canceledAt       DateTime?
  lastSyncedAt     DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments SubscriptionPayment[]

  @@index([status, trialEndsAt])
}

/// Historial de cobros de la suscripción. Un registro por cobro autorizado de Mercado Pago (idempotente).
model SubscriptionPayment {
  id                    String                    @id @default(cuid())
  subscriptionId        String
  businessId            String
  mpAuthorizedPaymentId String                    @unique
  mpPaymentId           String?
  amountCents           Int
  currency              String                    @default("ARS")
  status                SubscriptionPaymentStatus
  detail                String?
  paidAt                DateTime?
  createdAt             DateTime                  @default(now())

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  earnings     CreatorEarning[]

  @@index([businessId, createdAt])
}

/// Creador / influencer con un código propio (ej. JUAN20) para traer barberías.
model Creator {
  id                String         @id @default(cuid())
  /// Siempre en mayúsculas. No se edita una vez creado (los links ya repartidos dejarían de andar).
  code              String         @unique
  name              String
  email             String?
  benefitType       CreatorBenefit @default(TRACKING)
  /// COMMISSION: porcentaje (1–100) de cada cobro.
  commissionPercent Int            @default(0)
  /// COMMISSION: cantidad de meses por barbería durante los que se paga comisión. null = de por vida.
  commissionMonths  Int?
  /// FREE_MONTHS: meses gratis que se acreditan por cada barbería que empieza a pagar.
  freeMonths        Int            @default(0)
  active            Boolean        @default(true)
  notes             String?
  createdAt         DateTime       @default(now())

  businesses Business[]
  earnings   CreatorEarning[]
}

/// Lo que se le debe a un creador. Se genera solo con cada cobro aprobado; el pago al creador es manual por ahora.
model CreatorEarning {
  id                    String        @id @default(cuid())
  creatorId             String
  businessId            String?
  /// Nombre de la barbería al momento del cobro (por si después se elimina).
  businessName          String
  subscriptionPaymentId String?
  kind                  EarningKind
  /// COMMISSION: monto en centavos.
  amountCents           Int           @default(0)
  /// FREE_MONTHS: meses a acreditar.
  months                Int           @default(0)
  status                EarningStatus @default(PENDING)
  note                  String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())

  creator Creator              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  payment SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id], onDelete: SetNull)

  @@unique([subscriptionPaymentId, kind])
  @@index([creatorId, status])
}

/// Dueños de la plataforma. Se crean solo desde la consola (npm run superadmin:create), nunca desde la web.
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------------------------------------------------------
// Contenido de la página pública (portada, galería, reseñas, acerca de, contacto)
// ----------------------------------------------------------------------------------------------------------

enum PhotoKind {
  HERO
  GALLERY
}

enum ReviewStatus {
  /// Enviada por un cliente, esperando aprobación del administrador.
  PENDING
  APPROVED
  /// Aprobada alguna vez o rechazada: no se muestra, pero queda guardada.
  HIDDEN
}

enum ReviewSource {
  ADMIN
  CLIENT
}

/// Textos, contacto y redes de la página pública. Una fila por barbería (se crea al guardar por primera vez).
model BusinessProfile {
  businessId     String  @id
  aboutTitle     String?
  aboutText      String?
  policyText     String?
  /// Teléfono y WhatsApp en formato internacional (E.164), validados al guardar.
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  /// Link de Google Maps validado; si falta, se arma uno a partir de la dirección.
  mapsUrl        String?
  /// Links ya normalizados (https).
  instagram      String?
  facebook       String?
  tiktok         String?
  youtube        String?
  website        String?
  /// Si está activo, la página pública muestra reseñas y deja que los clientes envíen la suya (con aprobación).
  reviewsEnabled Boolean @default(false)
  /// Cuántas fotos de la galería se ven a la vez en la página pública; el resto se desliza hacia el costado.
  galleryVisible Int     @default(4)
  /// Si está activo, la galería pública muestra todo junto en formato collage en lugar de la fila deslizable.
  galleryShowAll Boolean @default(false)
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

enum ScheduleMode {
  AUTO
  MANUAL
}

enum MediaType {
  IMAGE
  VIDEO
}

/// Elemento de la portada (solo imágenes) o de la galería (fotos y videos cortos). Los archivos viven en Vercel Blob;
/// acá solo se guardan las URLs y los metadatos.
model BusinessPhoto {
  id         String    @id @default(cuid())
  businessId String
  url        String
  kind       PhotoKind
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  mediaType  MediaType @default(IMAGE)
  /// Videos: imagen de portada (poster) que se ve mientras el video carga.
  posterUrl  String?
  width      Int?
  height     Int?
  /// Videos: duración y peso, informativos (los límites se validan al subir).
  durationMs Int?
  sizeBytes  Int?
  /// Oculto = sigue guardado pero no se muestra en la página pública.
  visible    Boolean   @default(true)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, kind, sortOrder])
}

model Review {
  id         String       @id @default(cuid())
  businessId String
  authorName String
  /// 1 a 5.
  rating     Int
  comment    String
  status     ReviewStatus @default(PENDING)
  source     ReviewSource @default(CLIENT)
  createdAt  DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status, createdAt])
}
