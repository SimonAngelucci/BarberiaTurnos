generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AppointmentStatus {
  /// Reservó y eligió pagar online: el horario queda retenido unos minutos hasta que se aprueba el pago.
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MessageKind {
  CONFIRMATION
  REMINDER
  CANCELLATION
  /// Pago recibido + turno confirmado (reemplaza a CONFIRMATION cuando se pagó online).
  PAYMENT
  /// El cliente reprogramó su turno con el código de reclamo.
  RESCHEDULE
  /// El cliente canceló su turno con el código de reclamo.
  SELF_CANCEL
}

enum AppointmentEventKind {
  CREATED
  RESCHEDULED
  CANCELLED
}

enum EventActor {
  CLIENT
  ADMIN
  SYSTEM
}

enum PaymentMode {
  DEPOSIT_ONLY
  FULL_ONLY
  BOTH
}

enum DepositType {
  PERCENT
  FIXED
}

/// Estado de cobro del turno.
enum PaymentStatus {
  UNPAID
  /// El cliente eligió pagar en el local (efectivo o físico) pudiendo pagar online.
  PENDING_AT_STORE
  DEPOSIT_PAID
  PAID
}

enum PaymentKind {
  DEPOSIT
  FULL
}

enum PaymentState {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

/// Tenant. En el MVP hay una sola fila; todo cuelga de businessId para poder escalar a multi-tenant.
model Business {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  tagline            String   @default("Reservá tu turno online")
  logoUrl            String?
  primaryColor       String   @default("#111827")
  /// Color de fondo de la página pública (y del panel si applyBgToAdmin).
  bgColor            String   @default("#fafafa")
  applyBgToAdmin     Boolean  @default(false)
  /// Diseño de la página pública (editor visual). null = diseño por defecto. Ver src/lib/page-config.ts.
  pageConfig         Json?
  timezone           String   @default("America/Argentina/Buenos_Aires")
  currency           String   @default("ARS")
  slotIntervalMin    Int      @default(30)
  minNoticeMin       Int      @default(60)
  maxAdvanceDays     Int      @default(30)
  /// Minutos antes del turno en que se envía recordatorio. Ej: [1440, 120]
  reminderOffsetsMin Int[]    @default([1440, 120])
  confirmTemplate    String   @default("Hola {{nombre}}! Tu turno de {{servicio}} en {{negocio}} quedó confirmado para el {{fecha}} a las {{hora}}. ¡Te esperamos!")
  reminderTemplate   String   @default("Hola {{nombre}}, te recordamos tu turno de {{servicio}} en {{negocio}}: {{fecha}} a las {{hora}}.")
  cancelTemplate     String   @default("Hola {{nombre}}, lamentablemente tu turno de {{servicio}} del {{fecha}} a las {{hora}} en {{negocio}} fue cancelado. Escribinos para reprogramar.")
  paymentTemplate    String   @default("Hola {{nombre}}! Recibimos tu pago de {{monto}} por tu turno de {{servicio}} en {{negocio}}. Quedó confirmado para el {{fecha}} a las {{hora}}. ¡Te esperamos!")

  // --- Reprogramar / cancelar por el cliente (con el código de reclamo) ---
  allowClientChanges Boolean  @default(true)
  /// Anticipación mínima, en minutos, para poder reprogramar o cancelar (0 = hasta el momento del turno).
  changeMinNoticeMin Int      @default(120)
  rescheduleTemplate String   @default("Hola {{nombre}}, tu turno de {{servicio}} en {{negocio}} fue reprogramado: ahora es el {{fecha}} a las {{hora}} (antes: {{fecha_anterior}} a las {{hora_anterior}}). Tu código sigue siendo {{codigo}}.")
  selfCancelTemplate String   @default("Hola {{nombre}}, cancelaste tu turno de {{servicio}} del {{fecha}} a las {{hora}} en {{negocio}}. Cuando quieras, reservá uno nuevo.")

  // --- Pagos (Mercado Pago, credenciales propias de cada barbería) ---
  paymentsEnabled    Boolean     @default(false)
  paymentMode        PaymentMode @default(BOTH)
  depositType        DepositType @default(PERCENT)
  /// PERCENT: 1–100. FIXED: monto en centavos.
  depositValue       Int         @default(30)
  /// Permite reservar sin pagar en el momento ("Pagar después").
  allowPayLater      Boolean     @default(true)
  /// Access Token de Mercado Pago, cifrado (AES-256-GCM). Nunca se devuelve al navegador.
  mpAccessToken      String?
  /// Etiqueta de la cuenta conectada (ej. nickname) para mostrar en el panel.
  mpAccountLabel     String?
  createdAt          DateTime @default(now())

  admins       AdminUser[]
  barbers      Barber[]
  services     Service[]
  customers    Customer[]
  appointments Appointment[]
  timeOffs     TimeOff[]
  messages     Message[]
}

model AdminUser {
  id           String   @id @default(cuid())
  businessId   String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Barber {
  id         String   @id @default(cuid())
  businessId String
  name       String
  photoUrl   String?
  bio        String?
  active     Boolean  @default(true)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  workingHours  WorkingHour[]
  disabledSlots DisabledSlot[]
  appointments  Appointment[]
  timeOffs      TimeOff[]
}

/// Slot individual desactivado dentro de la franja laboral (recurrente por día de semana).
/// startMin = minutos desde 00:00 locales del inicio de la celda (alineada al slotIntervalMin).
model DisabledSlot {
  id       String @id @default(cuid())
  barberId String
  weekday  Int
  startMin Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday, startMin])
}

/// Franja laboral. weekday: 0=domingo ... 6=sábado. Minutos desde 00:00 locales.
/// Varias filas por día = horario cortado (mañana/tarde).
model WorkingHour {
  id       String @id @default(cuid())
  barberId String
  weekday  Int
  startMin Int
  endMin   Int
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
}

/// Bloqueos (vacaciones, feriados, descansos). barberId null = todo el negocio.
model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  barberId   String?
  startAt    DateTime
  endAt      DateTime
  reason     String?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barber     Barber?  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([businessId, startAt])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  priceCents  Int
  durationMin Int
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  appointments Appointment[]
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  firstName  String
  lastName   String
  /// E.164, ej: +5491112345678
  phone      String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@unique([businessId, phone])
}

/// startAt/endAt en UTC. La restricción anti-overbooking vive en prisma/constraints.sql.
model Appointment {
  id         String            @id @default(cuid())
  businessId String
  /// null = el barbero fue eliminado; el turno queda en el historial.
  barberId   String?
  serviceId  String
  customerId String
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(CONFIRMED)
  priceCents Int
  paymentStatus   PaymentStatus @default(UNPAID)
  amountPaidCents Int           @default(0)
  /// Código para que el cliente reprograme o cancele (ej. REC-8F3K9A). null en turnos anteriores a esta función.
  claimCode  String?           @unique
  createdAt  DateTime          @default(now())

  events   AppointmentEvent[]
  payments Payment[]
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barber   Barber?  @relation(fields: [barberId], references: [id], onDelete: SetNull)
  service  Service  @relation(fields: [serviceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  messages Message[]

  @@index([businessId, startAt])
  @@index([barberId, startAt])
}

/// Historial de cambios de un turno (creación, reprogramaciones, cancelaciones) y quién los hizo.
model AppointmentEvent {
  id            String               @id @default(cuid())
  businessId    String
  appointmentId String
  kind          AppointmentEventKind
  actor         EventActor
  fromStartAt   DateTime?
  toStartAt     DateTime?
  note          String?
  createdAt     DateTime             @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@index([businessId, createdAt])
}

/// Intento de cobro (una preferencia de Mercado Pago). `id` viaja como external_reference.
model Payment {
  id             String       @id @default(cuid())
  businessId     String
  appointmentId  String
  kind           PaymentKind
  amountCents    Int
  state          PaymentState @default(PENDING)
  mpPreferenceId String?
  mpPaymentId    String?      @unique
  /// Observaciones operativas (ej. cobro aprobado cuando el horario ya se había liberado).
  note           String?
  createdAt      DateTime     @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([businessId, state])
  @@index([appointmentId])
}

/// Outbox de WhatsApp: se inserta en la misma operación que el turno y un worker/cron la despacha.
model Message {
  id            String        @id @default(cuid())
  businessId    String
  appointmentId String?
  kind          MessageKind
  to            String
  body          String
  templateName  String?
  params        Json?
  sendAt        DateTime
  status        MessageStatus @default(PENDING)
  attempts      Int           @default(0)
  error         String?
  externalId    String?
  createdAt     DateTime      @default(now())

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
}
